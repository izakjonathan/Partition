# All values except the optional DOB settings are required before opening the form.
PETITION_TITLE=
# Paste the exact full text supporters are agreeing to. The form stays closed until set.
PETITION_STATEMENT=
# Increment this label whenever the statement changes. Each supporter retains the exact text they saw.
PETITION_REVISION=1
CONTROLLER_NAME=
CONTROLLER_ADDRESS=
PRIVACY_EMAIL=
# UTC date after which entries are deleted (choose a justified date).
RETENTION_DATE=
# Only enable this if you have a documented need for an exact birth date.
COLLECT_DOB=false
DOB_PURPOSE=
# Never put these values in NEXT_PUBLIC_ variables.
DATABASE_URL=
# A verified domain and sender address are needed for confirmation email.
SITE_URL=
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=
# Set after the separate Vercel admin project has All Deployments protection enabled.
ADMIN_URL=
# Secret used by Vercel's daily deletion job; generate a random 32+ byte value.
CRON_SECRET=
