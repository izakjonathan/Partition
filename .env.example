# All values except the optional DOB settings are required before opening the form.
# Title is seeded with the statement in the database.
# The statement is drafted and published from /admin; no statement environment variable is needed.
# Organiser and venue address are set in the app.
# Optional: defaults to the current manager email.
PRIVACY_EMAIL=
# Confirmed responses are deleted six months after submission.
# Only enable this if you have a documented need for an exact birth date.
COLLECT_DOB=false
DOB_PURPOSE=
# Never put these values in NEXT_PUBLIC_ variables.
DATABASE_URL=
# Individual confirmation mail through Apple iCloud SMTP (app-specific password).
SITE_URL=
ICLOUD_APP_PASSWORD=
# Manager login at /admin/sign-in. Set both as Production secrets in this Vercel project.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Secret used by Vercel's daily deletion job; generate a random 32+ byte value.
CRON_SECRET=
